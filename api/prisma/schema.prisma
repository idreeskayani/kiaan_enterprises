generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL_POOLED")
  directUrl = env("DATABASE_URL")
}

enum Role {
  ADMIN
  OPERATOR
  ACCOUNTANT
  CLEARING_AGENT
}

enum Mode {
  AIR
  SEA
  ROAD
}

enum ShipmentStatus {
  BOOKED
  IN_TRANSIT
  LANDED
  AWAITING_GATEPASS
  GATEPASS_ISSUED
  DELIVERED
  ON_HOLD
  CUSTOMS_EXAM
  CANCELLED
  DRAFT
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  CANCELLED
}

model User {
  id        String          @id @default(uuid())
  email     String          @unique
  password  String
  role      Role            @default(OPERATOR)
  clearanceHistory ClearanceHistory[]
  createdAt DateTime        @default(now())
  history   StatusHistory[]
}

model Customer {
  id        String     @id @default(uuid())
  name      String
  phone     String?
  address   String?
  taxNumber String?
  shipments Shipment[]
  quotations Quotation[]
  invoices   Invoice[]
  duesReports DuesReport[]
}

model Shipment {
  id              String          @id @default(uuid())
  refNo           String          @unique
  customerId      String
  customer        Customer        @relation(fields: [customerId], references: [id])
  mode            Mode
  origin          String
  destination     String
  viaPoints       String[]        @default([])
  hsCodeId        String?
  hsCode          HsCode?         @relation(fields: [hsCodeId], references: [id])
  goodsValue      Decimal         @db.Decimal(14, 2)
  insurance       Decimal         @default(0) @db.Decimal(14, 2)
  status          ShipmentStatus  @default(BOOKED)
  blAwbNo         String?
  eta             DateTime?
  ratePerUnit     Decimal?        @db.Decimal(10, 2)
  minCharge       Decimal?        @db.Decimal(10, 2)
  fuelPct         Decimal?        @db.Decimal(5, 2)
  handling        Decimal?        @db.Decimal(10, 2)
  volDivisor      Int?
  freightOverride Decimal?        @db.Decimal(14, 2)
  doCharges       Decimal?        @db.Decimal(14, 2)
  freightLabel    String?
  currency        String          @default("USD")
  exRate          Decimal?        @db.Decimal(12, 4)
  hawbNo          String?
  flight          String?
  extraCharges    Json?
  details         Json?
  dutyPct         Decimal?        @db.Decimal(5, 2)
  salesTaxPct     Decimal?        @db.Decimal(5, 2)
  whtPct          Decimal?        @db.Decimal(5, 2)
  items           ShipmentItem[]
  history         StatusHistory[]
  invoice         Invoice?
  createdAt       DateTime        @default(now())
  clearance        ClearanceJob?
  quotation       Quotation?
}

model ShipmentItem {
  id         String   @id @default(uuid())
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  lengthCm   Decimal  @db.Decimal(10, 2)
  widthCm    Decimal  @db.Decimal(10, 2)
  heightCm   Decimal  @db.Decimal(10, 2)
  weightKg   Decimal  @db.Decimal(10, 2)
  qty        Int      @default(1)
}

model RateCard {
  id          String  @id @default(uuid())
  mode        Mode
  origin      String
  destination String
  ratePerUnit Decimal @db.Decimal(10, 2)
  minCharge   Decimal @default(0) @db.Decimal(10, 2)
  fuelPct     Decimal @default(0) @db.Decimal(5, 2)
  handling    Decimal @default(0) @db.Decimal(10, 2)

  @@unique([mode, origin, destination])
}

model HsCode {
  id          String     @id @default(uuid())
  code        String     @unique
  description String
  dutyPct     Decimal    @db.Decimal(5, 2)
  salesTaxPct Decimal    @db.Decimal(5, 2)
  whtPct      Decimal    @default(0) @db.Decimal(5, 2)
  shipments   Shipment[]
  clearanceJobs    ClearanceJob[]
}

model Invoice {
  id         String        @id @default(uuid())
  invoiceNo  String        @unique
  // Set when the invoice belongs to a shipment. An invoice made on its own has none.
  shipmentId String?       @unique
  shipment   Shipment?     @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  // Standalone invoices keep their own customer and details (route, packages ...).
  customerId String?
  customer   Customer?     @relation(fields: [customerId], references: [id])
  details    Json?
  clearanceJob     ClearanceJob?
  status     InvoiceStatus @default(DRAFT)
  total      Decimal       @db.Decimal(14, 2)
  dueAmount  Decimal       @default(0) @db.Decimal(14, 2)
  lines      InvoiceLine[]
  costs      InvoiceCost[]
  payments   Payment[]
  issuedAt   DateTime      @default(now())
}

model InvoiceLine {
  id        String  @id @default(uuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  label     String
  amount    Decimal @db.Decimal(14, 2)
  currency      String?
  foreignAmount Decimal? @db.Decimal(14, 2)
  exRate        Decimal? @db.Decimal(12, 4)
}

enum CostPayment {
  UNPAID
  PARTIAL
  PAID
}

// Money spent to deliver an invoice (debit). Profit = invoice total - sum of costs.
model InvoiceCost {
  id            String   @id @default(uuid())
  invoiceId     String
  invoice       Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  label         String
  vendor        String?
  amount        Decimal  @db.Decimal(14, 2) // always PKR
  currency      String?
  foreignAmount Decimal? @db.Decimal(14, 2)
  exRate        Decimal? @db.Decimal(12, 4)
  note          String?
  incurredAt    DateTime @default(now())
  // whether WE have paid this vendor yet. dueAmount = still owed to the vendor (PKR) when PARTIAL
  payment       CostPayment @default(UNPAID)
  dueAmount     Decimal  @default(0) @db.Decimal(14, 2)
  payments      Payment[]

  @@index([invoiceId])
  @@index([vendor])
}

enum PaymentMethod {
  CASH
  CHEQUE
  ONLINE
}

// CREDIT = money received from a customer (invoice), DEBIT = money paid to a vendor (cost)
enum PaymentDirection {
  CREDIT
  DEBIT
}

// One payment event. Exactly one of invoiceId / costId / clearanceJobId is set.
model Payment {
  id        String           @id @default(uuid())
  direction PaymentDirection
  method    PaymentMethod
  // cheque number (required for CHEQUE) or transaction reference (ONLINE, optional)
  reference String?
  amount    Decimal          @db.Decimal(14, 2)
  // optional proof picture, kept as a compressed data URL
  hasImage  Boolean          @default(false)
  imageData String?
  invoiceId String?
  invoice   Invoice?         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  costId    String?
  cost      InvoiceCost?     @relation(fields: [costId], references: [id], onDelete: Cascade)
  // clearance agent section: money received for a clearance invoice
  clearanceJobId String?
  clearanceJob   ClearanceJob?    @relation(fields: [clearanceJobId], references: [id], onDelete: Cascade)
  paidAt    DateTime         @default(now())

  @@index([invoiceId])
  @@index([costId])
  @@index([clearanceJobId])
}

// A saved statement of one clearance customer (same idea as DuesReport, but clearance customers are
// kept by name on each job). `snapshot` freezes the figures as they were when it was saved or sent.
model ClearanceReport {
  id           String           @id @default(uuid())
  reportNo     String           @unique
  customerName String
  status       DuesReportStatus @default(DRAFT)
  // which invoices it lists: ALL | PARTIAL | UNPAID | PAID | DRAFT (same as the clearance invoice filters)
  scope        String           @default("ALL")
  totalDue     Decimal          @db.Decimal(14, 2)
  invoiceCount Int
  snapshot     Json
  createdAt    DateTime         @default(now())

  @@index([customerName])
}

enum DuesReportStatus {
  DRAFT
  SENT
}

// A saved copy of a customer's remaining-dues statement. `snapshot` keeps the figures as they were
// when the report was saved or sent, so an old report never changes when payments are recorded later.
model DuesReport {
  id          String           @id @default(uuid())
  reportNo    String           @unique
  customerId  String
  customer    Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  status      DuesReportStatus @default(DRAFT)
  // which invoices the report lists: ALL | DUES | UNPAID | PAID | DRAFT (same as the filters on the Invoices page)
  scope       String           @default("DUES")
  totalDue    Decimal          @db.Decimal(14, 2)
  invoiceCount Int
  snapshot    Json
  createdAt   DateTime         @default(now())

  @@index([customerId])
}

model StatusHistory {
  id         String         @id @default(uuid())
  shipmentId String
  shipment   Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  status     ShipmentStatus
  note       String?
  userId     String
  user       User           @relation(fields: [userId], references: [id])
  at         DateTime       @default(now())
}
model ExchangeRate {
  id        String   @id @default(uuid())
  currency  String   @unique
  rate      Decimal  @db.Decimal(12, 4)
  updatedAt DateTime @updatedAt
}
enum ClearanceStatus {
  PENDING
  DOCS_RECEIVED
  GD_FILED
  ASSESSED
  DUTY_PAID
  EXAMINATION
  RELEASED
  ON_HOLD
  CANCELLED
}

enum ClearancePayment {
  UNPAID
  PARTIAL
  PAID
  DRAFT
}

model ClearanceJob {
  id              String             @id @default(uuid())
  jobNo           String             @unique
  shipmentId      String?            @unique
  shipment        Shipment?          @relation(fields: [shipmentId], references: [id])
  sourceInvoiceId String?            @unique
  sourceInvoice   Invoice?           @relation(fields: [sourceInvoiceId], references: [id], onDelete: SetNull)
  customerName    String
  customerAddress String?
  customerPhone   String?
  customerTax     String?
  details         Json               @default("{}")
  hsCodeId        String?
  hsCode          HsCode?            @relation(fields: [hsCodeId], references: [id])
  assessableValue Decimal            @default(0) @db.Decimal(14, 2)
  collectorate    String?
  modeOfTransport String?
  virNumber       String?
  duties          Json               @default("{}")
  gdNo            String?
  status          ClearanceStatus    @default(PENDING)
  includeFreight  Boolean            @default(false)
  importedLines   Json               @default("[]")
  lines           Json               @default("[]")
  total           Decimal            @default(0) @db.Decimal(14, 2)
  invoiceNo       String?            @unique
  invoicedAt      DateTime?
  payment         ClearancePayment?
  dueAmount       Decimal            @default(0) @db.Decimal(14, 2)
  history         ClearanceHistory[]
  payments        Payment[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}

model ClearanceHistory {
  id     String          @id @default(uuid())
  jobId  String
  job    ClearanceJob    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  status ClearanceStatus
  note   String?
  userId String
  user   User            @relation(fields: [userId], references: [id])
  at     DateTime        @default(now())
}

enum QuotationStatus {
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  DRAFT
}

// A price offer. Accepting it creates the Shipment (BOOKED) from the saved payload.
model Quotation {
  id         String          @id @default(uuid())
  quoteNo    String          @unique
  customerId String
  customer   Customer        @relation(fields: [customerId], references: [id])
  payload    Json
  total      Decimal         @db.Decimal(14, 2)
  validUntil DateTime
  status     QuotationStatus @default(DRAFT)
  shipmentId String?         @unique
  shipment   Shipment?       @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  createdAt  DateTime        @default(now())
}
